{
  "name": "doctocat-nextjs-site",
  "version": "0.0.15",
  "private": true,
  "description": "Documentation theme",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "check": "tsc --noEmit",
    "build": "rm -rf out && next build --webpack",
    "lint": "eslint '**/*.{js,ts,tsx,md,mdx}' --max-warnings=0",
    "format": "prettier --write '**/*.{js,ts,tsx,md,mdx,json,css,scss}'",
    "start": "next start"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/primer/doctocat-nextjs.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/primer/doctocat-nextjs/issues"
  },
  "homepage": "https://github.com/primer/doctocat-nextjs#readme",
  "dependencies": {
    "@primer/doctocat-nextjs": "^0.11.0",
    "@primer/octicons-react": "19.33.0",
    "eslint-config-next": "16.3.0",
    "next": "16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@github/prettier-config": "^0.0.6",
    "@primer/react": "38.35.1",
    "@primer/react-brand": "0.74.0",
    "@types/node": "24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4"
  }
}
